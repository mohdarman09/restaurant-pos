NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_pos

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Optional — enables the "Email Receipt" button. Leave blank to disable email delivery
# (the button will show a clear "not configured" message instead of failing silently).
# Example values for Gmail SMTP, SendGrid, Amazon SES, etc:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourrestaurant.com
