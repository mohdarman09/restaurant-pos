{
  "name": "restaurant-pos-backend",
  "version": "1.0.0",
  "description": "Restaurant POS System — Backend API (Node.js + Express + TypeScript + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "psql \"$DATABASE_URL\" -f ../database/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f ../database/seed.sql",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "pdfkit": "^0.15.0",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/pdfkit": "^0.13.4",
    "@types/nodemailer": "^6.4.15",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.11.6",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "eslint": "^8.57.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
