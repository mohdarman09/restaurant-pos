# Leave unset for local dev — Vite's dev server proxy (vite.config.ts) forwards
# /api and /socket.io to http://localhost:4000 automatically.
#
# For production (Vercel), set this in the project's Environment Variables
# to your deployed backend URL, e.g.:
# VITE_API_URL=https://restaurant-pos-o94b.onrender.com/api
VITE_API_URL=
